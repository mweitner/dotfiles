#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
PROFILE_DIR="$DOTFILES/dnsmasq/config"
ACTIVE_FILE="/etc/dnsmasq.d/10-dotfiles-active.conf"
STATE_FILE="/var/lib/dnsmasq-dotfiles/active-profile"

PROFILE=""
SHOW_ONLY=false
LIST_ONLY=false
NFS_EXPORT_FILE="/etc/exports.d/50-dotfiles-netboot.exports"
NFS_EXPORT_LINES=()

# Netboot profiles export their project's root/image folders via NFS.
# Add an entry here for every dnsmasq profile that netboots a target machine.
NETBOOT_PROFILES=(
  "imx6s-mcg-netboot"
  "imx6qleg-mcg-netboot"
)

is_netboot_profile() {
  local candidate
  for candidate in "${NETBOOT_PROFILES[@]}"; do
    if [[ "$PROFILE" == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

set_nfs_export_lines() {
  case "$PROFILE" in
    imx6s-mcg-netboot)
      NFS_EXPORT_LINES=(
        "/opt/netboot/linux-dps-scarthgap/root/imx6s-mcg 192.168.3.0/24(rw,no_root_squash,no_subtree_check)"
        "/opt/netboot/linux-dps-scarthgap/image/imx6s-mcg 192.168.3.0/24(rw,no_root_squash,no_subtree_check)"
      )
      ;;
    imx6qleg-mcg-netboot)
      NFS_EXPORT_LINES=(
        "/opt/netboot/linux-dps-kirkstone/root/imx6qleg-mcg 192.168.3.0/24(rw,no_root_squash,no_subtree_check)"
        "/opt/netboot/linux-dps-kirkstone/image/imx6qleg-mcg 192.168.3.0/24(rw,no_root_squash,no_subtree_check)"
      )
      ;;
    *)
      NFS_EXPORT_LINES=()
      ;;
  esac
}

has_systemd_unit() {
  local unit="$1"

  if systemctl cat "$unit" >/dev/null 2>&1; then
    return 0
  fi

  [[ -f "/usr/lib/systemd/system/$unit" ]] || [[ -f "/etc/systemd/system/$unit" ]]
}

usage() {
  cat <<'EOF'
Usage:
  setup-dnsmasq-profile --profile <name>
  setup-dnsmasq-profile --show
  setup-dnsmasq-profile --list

Options:
  --profile <name>   Activate dnsmasq profile from $DOTFILES/dnsmasq/config
  --show             Show active profile and dnsmasq service state
  --list             List available profiles
  -h, --help         Show this help

Examples:
  setup-dnsmasq-profile --list
  setup-dnsmasq-profile --profile ulm-nas
  setup-dnsmasq-profile --show

Notes:
  - This helper is implemented in Bash and is shell-agnostic when executed as a command.
  - Keep shared docs/examples in Bash/POSIX syntax; when using fish interactively, run Bash snippets via: bash -lc '<command>'.
EOF
}

list_profiles() {
  if [[ ! -d "$PROFILE_DIR" ]]; then
    return 0
  fi

  find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' \
    | sed 's/\.conf$//' \
    | sort
}

show_status() {
  local active=""

  if [[ -f "$STATE_FILE" ]]; then
    active="$(sudo cat "$STATE_FILE" 2>/dev/null || true)"
  fi

  if [[ -z "$active" && -f "$ACTIVE_FILE" ]]; then
    active="$(basename "$ACTIVE_FILE")"
  fi

  echo "Active dnsmasq profile: ${active:-unknown}"
  echo "Active config file: $ACTIVE_FILE"
  systemctl --no-pager --full status dnsmasq | sed -n '1,15p' || true

  if [[ -f "$NFS_EXPORT_FILE" ]]; then
    echo "Active NFS export file: $NFS_EXPORT_FILE"
    sudo cat "$NFS_EXPORT_FILE" 2>/dev/null || true
  else
    echo "Active NFS export file: none"
  fi

  if has_systemd_unit nfs-server.service; then
    systemctl --no-pager --full status rpcbind nfs-server 2>/dev/null | sed -n '1,20p' || true
  fi
}

activate_netboot_nfs() {
  set_nfs_export_lines

  if [[ ${#NFS_EXPORT_LINES[@]} -eq 0 ]]; then
    echo "ERROR: no NFS export lines configured for netboot profile: $PROFILE" >&2
    return 1
  fi

  sudo mkdir -p /etc/exports.d
  sudo tee "$NFS_EXPORT_FILE" >/dev/null <<EOF
$(printf '%s\n' "${NFS_EXPORT_LINES[@]}")
EOF

  if has_systemd_unit rpcbind.socket; then
    sudo systemctl enable --now rpcbind.socket
  fi

  if has_systemd_unit rpcbind.service; then
    sudo systemctl enable --now rpcbind
  fi

  if ! has_systemd_unit nfs-server.service; then
    echo "ERROR: nfs-server.service not found. Install nfs-utils and rerun." >&2
    return 1
  fi

  sudo systemctl enable --now nfs-server
  sudo exportfs -rav

  if ! sudo rpcinfo -p localhost 2>/dev/null | grep -qE '[[:space:]](nfs|mountd)$'; then
    echo "ERROR: NFS RPC programs are not registered (nfs/mountd missing)." >&2
    echo "Run: sudo systemctl status rpcbind.socket rpcbind nfs-server nfs-mountd" >&2
    return 1
  fi
}

deactivate_netboot_nfs() {
  if [[ -f "$NFS_EXPORT_FILE" ]]; then
    sudo rm -f "$NFS_EXPORT_FILE"
    if has_systemd_unit nfs-server.service; then
      sudo exportfs -rav 2>/dev/null || true
    fi
  fi
}

ensure_nfs_stack() {
  if ! has_systemd_unit nfs-server.service || ! command -v rpcinfo >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
      echo "==> Installing nfs-utils..."
      sudo dnf install -y nfs-utils
      sudo systemctl daemon-reload
    fi
  fi

  if ! has_systemd_unit nfs-server.service; then
    echo "ERROR: nfs-server.service not found after nfs-utils install." >&2
    return 1
  fi

  if ! command -v rpcinfo >/dev/null 2>&1; then
    echo "ERROR: rpcinfo command not found after nfs-utils install." >&2
    return 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="${2:-}"
      shift 2
      ;;
    --show)
      SHOW_ONLY=true
      shift
      ;;
    --list)
      LIST_ONLY=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ "$LIST_ONLY" == true ]]; then
  list_profiles
  exit 0
fi

if [[ "$SHOW_ONLY" == true ]]; then
  show_status
  exit 0
fi

if [[ -z "$PROFILE" ]]; then
  echo "Error: missing --profile <name>" >&2
  usage
  exit 1
fi

if [[ ! -d "$PROFILE_DIR" ]]; then
  echo "Error: profile directory not found: $PROFILE_DIR" >&2
  exit 1
fi

SRC_FILE="$PROFILE_DIR/$PROFILE.conf"
if [[ ! -f "$SRC_FILE" ]]; then
  echo "Error: profile not found: $SRC_FILE" >&2
  echo "Available profiles:" >&2
  list_profiles >&2 || true
  exit 1
fi

if ! command -v dnsmasq >/dev/null 2>&1; then
  echo "==> Installing dnsmasq..."
  sudo dnf install -y dnsmasq
fi

if is_netboot_profile; then
  ensure_nfs_stack
fi

sudo mkdir -p /etc/dnsmasq.d
sudo mkdir -p /var/lib/dnsmasq-dotfiles
sudo install -m 0644 "$SRC_FILE" "$ACTIVE_FILE"

if is_netboot_profile; then
  activate_netboot_nfs
else
  deactivate_netboot_nfs
fi

echo "$PROFILE" | sudo tee "$STATE_FILE" >/dev/null

# If firewalld is active, ensure DNS/DHCP from machine networks can reach dnsmasq.
if sudo firewall-cmd --state >/dev/null 2>&1; then
  ifname="$(awk -F= '/^interface=/{print $2; exit}' "$SRC_FILE" 2>/dev/null || true)"
  zone=""
  if [[ -n "$ifname" ]]; then
    zone="$(sudo firewall-cmd --get-zone-of-interface="$ifname" 2>/dev/null || true)"
  fi
  if [[ -z "$zone" ]]; then
    zone="$(sudo firewall-cmd --get-default-zone 2>/dev/null || echo FedoraServer)"
  fi

  sudo firewall-cmd --zone="$zone" --query-service=dns >/dev/null 2>&1 || sudo firewall-cmd --zone="$zone" --add-service=dns
  sudo firewall-cmd --permanent --zone="$zone" --query-service=dns >/dev/null 2>&1 || sudo firewall-cmd --permanent --zone="$zone" --add-service=dns
  sudo firewall-cmd --zone="$zone" --query-service=dhcp >/dev/null 2>&1 || sudo firewall-cmd --zone="$zone" --add-service=dhcp
  sudo firewall-cmd --permanent --zone="$zone" --query-service=dhcp >/dev/null 2>&1 || sudo firewall-cmd --permanent --zone="$zone" --add-service=dhcp
  sudo firewall-cmd --reload >/dev/null
fi

if ! sudo dnsmasq --test --conf-file=/etc/dnsmasq.conf >/dev/null; then
  echo "ERROR: dnsmasq config test failed. Service not restarted." >&2
  exit 1
fi

sudo systemctl enable dnsmasq >/dev/null
sudo systemctl restart dnsmasq

echo "==> Activated dnsmasq profile: $PROFILE"
show_status
